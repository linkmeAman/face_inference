# Existing secure application encryption settings (reuse compatible values).
FACE_EMBEDDING_KEY=
FACE_EMBEDDING_KEY_ID=
# Protected operator-approved report-bound calibration; empty disables acceptance.
FACE_WEB_CALIBRATION_FILE=
# No browser-face development/test acceptance flag exists.

# Protected explicitly approved tenant/member/template migration allowlist.
# Leave unset until the live legacy replacement is explicitly authorized.
FACE_WEB_LEGACY_MIGRATION_FILE=

# Protected expiring test-only pilot; never points at the shared tenant.
# Production thresholds remain controlled by FACE_WEB_CALIBRATION_FILE.
FACE_WEB_PILOT_FILE=

# Optional protected server scope overrides. Authorized batches default to
# SHADOW (no attendance writes); LIVE additionally needs calibrated matching.
# File outside web root, not world-readable; exact tenant/branch/batch approvals.
FACE_WEB_ROLLOUT_FILE=

# Sparse allowlisted JSON events, outside web root; directory writable by PHP
# and inaccessible to other users. 2MiB rotation + two backups (6MiB maximum).
# Database request journals remain the transactional source of persistence.
FACE_WEB_EVENT_LOG=
