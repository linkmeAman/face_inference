# Copy to the application's private service configuration directory.
# Do not commit real secrets or calibration data.
FACE_INFERENCE_HOST=127.0.0.1
FACE_INFERENCE_PORT=6120
FACE_INFERENCE_SHARED_SECRET=<generate-a-private-secret>
FACE_MODEL_DIR=/var/www/admin.creativeculturalcentre.in/services/face-inference/models
FACE_MODEL_MANIFEST=/var/www/admin.creativeculturalcentre.in/services/face-inference/models/MODEL-MANIFEST.json
FACE_YUNET_MODEL=/var/www/admin.creativeculturalcentre.in/services/face-inference/models/face_detection_yunet_2023mar_int8.onnx
FACE_SFACE_MODEL=/var/www/admin.creativeculturalcentre.in/services/face-inference/models/face_recognition_sface_2021dec_int8bq.onnx
FACE_PAD_MODEL=/var/www/admin.creativeculturalcentre.in/services/face-inference/models/anti-spoof-mn3.onnx
FACE_MODEL_VERSION=opencv-zoo-yunet-sface-int8-omz-anti-spoof-mn3
FACE_MODEL_VERSION_ID=0
FACE_RECOGNITION_PROVIDER_ID=local-onnx
FACE_RECOGNITION_PROVIDER_VERSION=1
FACE_RECOGNITION_PROVIDER_CLASS=FaceInferenceClient
# Optional custom adapters must be deployed below classes/providers/.
# FACE_RECOGNITION_PROVIDER_ADAPTER_FILE=/var/www/app/classes/providers/RemoteFaceProvider.php
FACE_CALIBRATION_POLICY_VERSION=unconfigured
FACE_ATTENDANCE_REQUIRE_HTTPS=1
FACE_ATTENDANCE_ALLOWED_ORIGINS=https://admin.example.org

# Point this only to a generated approved policy artifact, never raw images.
FACE_CALIBRATION_FILE=/etc/ccc/face-attendance/calibration-approved.json

# Leave unset until the representative PAD fixture run is approved. Without
# this artifact, passive PAD deliberately returns UNKNOWN and attendance is
# review-only.
FACE_PAD_CALIBRATION_FILE=
FACE_MAX_ATTEMPTS_PER_MINUTE=12
FACE_REPLAY_WINDOW_SECONDS=600
FACE_CHALLENGE_TTL_SECONDS=15
FACE_CHALLENGE_HEAD_TURN_DELTA=0.12
# Pilot-only bounded geometry diagnostics. Never logs frames or embeddings.
FACE_PILOT_GEOMETRY_DEBUG=0

# Disabled by default. The secret path is injected by systemd LoadCredential,
# never Nginx/PHP. The DSN is a dedicated account granted EXECUTE only.
FACE_EXPERIMENT_LOGGING_ENABLED=0
FACE_EXPERIMENT_ID_SECRET_FILE=/run/credentials/face-inference.service/face-experiment-id-secret
FACE_EXPERIMENT_OPAQUE_ID_VERSION=1
# FACE_EXPERIMENT_WRITER_DSN=mysql://face_experiment_writer:<secret>@127.0.0.1/ccc_database

# Keep all rollout writes disabled until written approval exists.
FACE_ATTENDANCE_ENABLED=0
FACE_ENROLLMENT_ENABLED=0
FACE_GUIDED_ADAPTIVE_V2_ENABLED=0
FACE_ATTENDANCE_SHADOW_MODE=1
FACE_ATTENDANCE_LIVE_WRITE=0
FACE_AUTO_LIVE_WRITE_BRANCH_IDS=
FACE_CAPTURE_NONCE_REQUIRED=1
FACE_PUNCH_OUT_ENABLED=0
FACE_ENROLLMENT_UNCALIBRATED_TEST_MODE=0
FACE_CALIBRATION_TEST_ENABLED=0
FACE_ALLOWED_BRANCH_IDS=
