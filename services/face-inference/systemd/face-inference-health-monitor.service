[Unit]
Description=Creative Cultural Centre face inference health monitor
After=face-inference.service

[Service]
Type=oneshot
User=ccc-face-inference
Group=ccc-face-inference
WorkingDirectory=/var/www/admin.creativeculturalcentre.in/services/face-inference
Environment=FACE_INFERENCE_URL=http://127.0.0.1:6120
ExecStart=/var/www/admin.creativeculturalcentre.in/services/face-inference/tools/health_monitor.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

