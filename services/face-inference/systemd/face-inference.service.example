[Unit]
Description=Creative Cultural Centre private face inference spike
After=network.target

[Service]
Type=simple
User=ccc-face-inference
Group=ccc-face-inference
WorkingDirectory=/var/www/admin.creativeculturalcentre.in/services/face-inference
EnvironmentFile=/etc/creativeculturalcentre/face-inference.env
ExecStart=/usr/bin/python3 -m app.main
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/creativeculturalcentre/face-inference

[Install]
WantedBy=multi-user.target
